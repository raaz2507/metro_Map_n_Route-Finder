<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 2.5D Orange Bottom Border Rim -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EA580C" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Card Face with 2.5dp Inset from Bottom -->
    <item android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#141417" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#2E2E33" />
        </shape>
    </item>
</layer-list>
