<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">

    <!-- 1. Header Bar: Identity & Live GPS Distance Capsule -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- App Identity (Left) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚆"
                android:textSize="12sp"
                android:paddingRight="4dp"
                android:paddingEnd="4dp" />

            <TextView
                android:id="@+id/notif_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="METRO LIVE PASS"
                android:textColor="#F97316"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/notif_status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_status_pill_bg"
                android:text="STANDBY"
                android:textColor="#9CA3AF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp" />
        </LinearLayout>

        <!-- Live Distance Capsule (Right) -->
        <LinearLayout
            android:id="@+id/notif_distance_badge"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_distance_badge"
            android:orientation="horizontal"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:gravity="center">

            <TextView
                android:id="@+id/notif_live_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 ---"
                android:textColor="#38BDF8"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. Stations Row: [ Start Station ] ━━━ ➔ ━━━ [ End Station ] -->
    <LinearLayout
        android:id="@+id/notif_route_stations_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_start_station"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start Station"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notif_arrow_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ➔ "
            android:textColor="#EA580C"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingLeft="6dp"
            android:paddingRight="6dp" />

        <TextView
            android:id="@+id/notif_end_station"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Destination"
            android:textColor="#FACC15"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 3. Metrics Chips: [ ⏱️ 24 Min ]  [ 📏 12.5 Km ]  [ 💰 ₹40 ] -->
    <LinearLayout
        android:id="@+id/notif_metrics_row"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Time Chip -->
        <TextView
            android:id="@+id/notif_chip_time"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_metric_pill_bg"
            android:gravity="center"
            android:text="⏱️ -- min"
            android:textColor="#34D399"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <!-- Distance Chip -->
        <TextView
            android:id="@+id/notif_chip_distance"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_metric_pill_bg"
            android:gravity="center"
            android:text="📏 -- km"
            android:textColor="#60A5FA"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <!-- Fare Chip -->
        <TextView
            android:id="@+id/notif_chip_fare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_metric_pill_bg"
            android:gravity="center"
            android:text="💰 ₹--"
            android:textColor="#FBBF24"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. Next Station Alert Screen -->
    <LinearLayout
        android:id="@+id/notif_alarm_pill"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_screen_bg"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_screen_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔"
            android:textSize="12sp"
            android:paddingRight="5dp"
            android:paddingEnd="5dp" />

        <TextView
            android:id="@+id/notif_station_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Target: Destination"
            android:textColor="#FDBA74"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 5. Action Buttons (Snooze & Dismiss) -->
    <LinearLayout
        android:id="@+id/notif_actions_container"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_btn_snooze"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_disabled"
            android:gravity="center"
            android:text="⏱ Snooze"
            android:textColor="#6B7280"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_btn_dismiss"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_disabled"
            android:gravity="center"
            android:text="🔕 Dismiss"
            android:textColor="#6B7280"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
