<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_prog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">

    <!-- Header: Journey Track & Time -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/notif_prog_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="📊 ROUTE TRACKER"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/notif_prog_eta_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_metric_pill_bg"
            android:text="⏱️ -- min"
            android:textColor="#34D399"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </RelativeLayout>

    <!-- Stations Row -->
    <LinearLayout
        android:id="@+id/notif_prog_stations_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_prog_start_station"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Origin"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notif_prog_arrow_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ➔ "
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingLeft="4dp"
            android:paddingRight="4dp" />

        <TextView
            android:id="@+id/notif_prog_end_station"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Destination"
            android:textColor="#FACC15"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Visual Metro Track Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_screen_bg"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_prog_track_visual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🟢━━━🟢━━━🚆━━━━━⚪━━━🏁"
            android:textColor="#34D399"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Target Alert Station / Info -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">

        <TextView
            android:id="@+id/notif_prog_target_station"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:text="Next Alert: Target Station"
            android:textColor="#FED7AA"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notif_prog_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            android:text="📍 ---"
            android:textColor="#38BDF8"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/notif_prog_actions_row"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_prog_btn_snooze"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_disabled"
            android:gravity="center"
            android:text="⏱ Snooze"
            android:textColor="#6B7280"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_prog_btn_dismiss"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_disabled"
            android:gravity="center"
            android:text="🔕 Dismiss"
            android:textColor="#6B7280"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
