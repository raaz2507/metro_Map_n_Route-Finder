						{"slab_id": 3, "min_km": 5, "max_km": 12, "probe": ["KG", "CTST"]},
						{"slab_id": 4, "min_km": 12, "max_km": 21, "probe": ["AHNR", "AIIMS"]},
						{"slab_id": 5, "min_km": 21, "max_km": 32, "probe": ["RCK", "HCC"]},
						{"slab_id": 6, "min_km": 32, "max_km": null, "probe": ["KG", "HCC"]}
					],
					"airport_express_stations": [
						{"code": "NDI", "name": "New Delhi"},
						{"code": "SJSU", "name": "Shivaji Stadium"},
						{"code": "DKV", "name": "Dhaula Kuan"},
